# .env.example
#
# A blank form for the settings each app needs to talk to the backend.
#
# HOW TO USE:
#   Mobile app: copy this file to apps/mobile/.env and fill in the two
#               EXPO_PUBLIC_ values.
#   Web app:    copy this file to apps/web/.env.local and fill in the two
#               NEXT_PUBLIC_ values.
# Ask Sakib for the real values. Those files are private and never shared in git.
#
# The anon key is NOT a secret password: it is the "public" key that every
# phone and every browser carries. The database's security rules are what
# protect the data. NEVER put the "service role" key in any app. That one is secret.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web app (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
